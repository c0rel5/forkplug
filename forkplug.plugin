# ----------------------------------------------------------------------------
# helpers
# ----------------------------------------------------------------------------

def dp(x: float) -> float:
    return x * float(AndroidUtilities.density)


def _jc(c):
    """Force a Java *int* ARGB colour. A plain Python int would resolve Paint.setColor to the
    setColor(long) overload (colour-long encoding) -> 'IllegalArgumentException: Invalid ID'."""
    c = int(c) & 0xFFFFFFFF
    if c >= 0x80000000:
        c -= 0x100000000
    return jint(c)


def _L(value: int):
    return jclass("java.lang.Long")(int(value))


_JCACHE: Dict[str, Any] = {}


def _static(cls_name: str, field: str):
    """Static field of a (possibly nested) Java class. Nested classes are always
    resolved through jclass('Outer$Inner'), which is the only form that is
    guaranteed to work under Chaquopy."""
    key = cls_name + "#" + field
    v = _JCACHE.get(key)
    if v is None:
        v = getattr(jclass(cls_name), field)
        _JCACHE[key] = v
    return v


def _style_stroke():
    return _static("android.graphics.Paint$Style", "STROKE")


def _style_fill():
    return _static("android.graphics.Paint$Style", "FILL")


def _cap_round():
    return _static("android.graphics.Paint$Cap", "ROUND")


def _join_round():
    return _static("android.graphics.Paint$Join", "ROUND")


def _new_tl(*names):
    last = None
    for n in names:
        try:
            return jclass(n)()
        except Exception as e:  # noqa
            last = e
    raise last if last else RuntimeError("no TL class")


