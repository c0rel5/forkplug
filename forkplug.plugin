_LOG = None
_HOOK_STATS: Dict[str, Dict[str, Any]] = {}

if MethodHook is not None:
    class FnHook(MethodHook):
        def __init__(self, name="", before=None, after=None):
            try:
                super().__init__()
            except Exception:
                pass
            self._name = name
            self._before = before
            self._after = after
            self._errors = 0
            self._fired = False
            self._st = _HOOK_STATS.setdefault(name, {"overloads": 0, "fired": 0, "errors": 0, "last": ""})

        def _run(self, fn, param):
            self._st["fired"] += 1
            if not self._fired:
                self._fired = True
                if _LOG:
                    _LOG.info("hook fired first time: " + self._name)
            try:
                fn(param)
            except Exception:
                self._errors += 1
                self._st["errors"] += 1
                self._st["last"] = traceback.format_exc()[-350:]
                if _LOG and self._errors <= 5:
                    _LOG.exception("hook error in " + self._name)

        def before_hooked_method(self, param):
            if self._before:
                self._run(self._before, param)

        def after_hooked_method(self, param):
            if self._after:
                self._run(self._after, param)
else:
    FnHook = None


# Drawable that renders a real profile photo through Telegram's ImageReceiver.
_PhotoDrawable = None
try:
    if java_subclass is not None:
        Drawable = jclass("android.graphics.drawable.Drawable")

        @java_subclass(Drawable)
        class _PhotoDrawable(Base):
            @joverride()
            def draw(self, canvas):
                try:
                    r = self.receiver
                    loaded = True
                    try:
                        loaded = bool(r.hasNotThumb())
                    except Exception:
                        pass
                    if not loaded and self.tries < 12:
                        now = time.time()
                        if now - self.last > 0.8:
                            self.last = now
                            self.tries += 1
                            r.setForUserOrChat(self.user, self.placeholder)
                            r.onAttachedToWindow()
                        self.plugin._schedule_refresh()
                    r.setImageCoords(0.0, 0.0, float(self.w), float(self.h))
                    r.draw(canvas)
                except Exception:
                    pass

            @joverride()
            def setAlpha(self, alpha):
                pass

            @joverride()
            def setColorFilter(self, cf):
                pass

            @joverride()
            def getOpacity(self):
                return -3
except Exception:
    _PhotoDrawable = None


