        self._check_update(False)

    def on_plugin_unload(self):
        self._restore_name()

    def _hook(self, clazz_name: str, method: str, before=None, after=None):
        key = clazz_name + "." + method
        st = _HOOK_STATS.setdefault(key, {"overloads": 0, "fired": 0, "errors": 0, "last": ""})
        try:
            clazz = find_class(clazz_name)
            if not clazz:
                st["overloads"] = -1
                st["last"] = "класс не найден"
                self.logger.error("class not found: " + clazz_name)
                return
            res = self.hook_all_methods(clazz, method, FnHook(key, before, after))
            st["overloads"] = len(res) if res else 0
            self.logger.info("hooked %s -> %s overloads" % (key, st["overloads"]))
        except Exception:
            st["overloads"] = -2
            st["last"] = traceback.format_exc()[-350:]
            self.logger.exception("hook failed " + key)

    def _show_diag(self, *a):
        try:
            lines = []
            for k, st in _HOOK_STATS.items():
                short = k.replace("org.telegram.", "").replace("ui.", "")
                state = {-1: "НЕТ КЛАССА", -2: "ОШИБКА ХУКА", 0: "НЕ ПОДКЛЮЧЁН"}.get(st["overloads"], "ок x%d" % st["overloads"])
                lines.append("%s\n   %s, сработал %d, ошибок %d" % (short, state, st["fired"], st["errors"]))
                if st["last"]:
                    for ln in st["last"].strip().splitlines()[-3:]:
                        lines.append("   " + ln[:160])
            try:
                dc = find_class(getattr(self, "_drawer_cls", "org.telegram.ui.ActionBar.DrawerLayoutContainer"))
                names = None
                for getter in (lambda: dc.getDeclaredMethods(),
                               lambda: dc.class_.getDeclaredMethods(),
                               lambda: jclass("java.lang.Class").forName(
                                   getattr(self, "_drawer_cls", "org.telegram.ui.ActionBar.DrawerLayoutContainer")).getDeclaredMethods()):
                    try:
                        names = sorted(set(str(m.getName()) for m in getter()))
                        break
                    except Exception:
                        continue
                if names is None:
                    raise RuntimeError("no methods")
                lines.append("DrawerLayoutContainer методы:\n   " + ", ".join(names))
            except Exception:
                lines.append("методы Drawer: не прочитать")
            tv = TextView(get_last_fragment().getParentActivity())
            tv.setText("\n".join(lines) or "пусто")
            tv.setTextSize(12.0)
            tv.setPadding(int(dp(20)), int(dp(8)), int(dp(20)), int(dp(8)))
            sv = ScrollView(get_last_fragment().getParentActivity())
            sv.addView(tv)
            b = AlertDialogBuilder(get_last_fragment().getParentActivity())
            b.set_title("Диагностика forkplug")
            b.set_view(sv)
            b.set_positive_button("Закрыть", lambda bb, w: bb.dismiss())
            b.show()
        except Exception:
            self.logger.exception("diag failed")

    def _install_hooks(self):
        self._hook("org.telegram.messenger.MessageObject", "generateLayout", before=self._on_generate_layout)
        self._hook("org.telegram.messenger.MessageObject", "addLinks", after=self._on_add_links)
        self._hook("org.telegram.ui.Cells.ChatMessageCell", "setMessageObject",
                   before=self._on_cell_before, after=self._on_cell_after)
        self._hook("org.telegram.ui.Components.MediaActionDrawable", "draw", before=self._on_media_draw)
        for drawer_cls in ("org.telegram.ui.ActionBar.DrawerLayoutContainer",
                           "org.telegram.ui.Components.DrawerLayoutContainer"):
            if find_class(drawer_cls):
                self._drawer_cls = drawer_cls
                # the method names differ between Telegram versions: hook every candidate
                self._hook(drawer_cls, "setDrawerPosition", after=self._on_drawer_position)
                self._hook(drawer_cls, "moveDrawerByX", after=self._on_drawer_position)
                self._hook(drawer_cls, "drawChild", before=self._on_drawer_position)
                self._hook(drawer_cls, "dispatchDraw", before=self._on_drawer_position)
                break
        else:
            self.logger.error("DrawerLayoutContainer not found")
        self._hook("org.telegram.ui.Components.RadialProgressView", "onDraw", before=self._on_spinner_draw)
        self._hook("org.telegram.ui.Cells.DialogCell", "onDraw",
                   before=self._on_dialog_before, after=self._on_dialog_after)
        self._hook("org.telegram.ui.Cells.ChatMessageCell", "drawNamesLayout", after=self._on_draw_names)
        self._hook("org.telegram.ui.ChatActivity$ChatMessageCellDelegate", "didPressReaction",
                   before=self._on_reaction_press)
        self._hook("org.telegram.ui.ChatActivity", "didPressReaction", before=self._on_reaction_press)

